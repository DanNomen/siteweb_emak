<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_form_fne" model="ir.ui.view">
        <field name="name">account.tax.form.inherit.fne</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="FNE" name="fne">
                    <group>
                        <field name="fne_tax_kind"/>
                        <field name="fne_vat_code" invisible="fne_tax_kind != 'vat'"
                               required="fne_tax_kind == 'vat'"/>
                        <field name="fne_custom_name" invisible="fne_tax_kind != 'custom'"
                               required="fne_tax_kind == 'custom'"
                               placeholder="AIRSI, GRA, DTD..."/>
                    </group>
                    <div class="text-muted">
                        Chaque ligne de facture doit porter exactement un code TVA FNE.
                        Les autres taxes sont transmises dans le champ customTaxes.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
