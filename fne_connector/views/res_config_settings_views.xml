<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_fne" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fne</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Facture Normalisée Électronique (FNE)" name="fne_block">
                    <setting id="fne_enabled_setting"
                             string="Certification FNE (DGI Côte d'Ivoire)"
                             help="Transmet les factures clients à la plateforme FNE pour certification.">
                        <field name="fne_enabled"/>
                        <div class="content-group mt16" invisible="not fne_enabled">
                            <div class="row">
                                <label for="fne_environment" class="col-lg-4 o_light_label"/>
                                <field name="fne_environment"/>
                            </div>
                            <div class="row">
                                <label for="fne_base_url" class="col-lg-4 o_light_label"/>
                                <field name="fne_base_url" placeholder="http://54.247.95.108/ws"/>
                            </div>
                            <div class="row">
                                <label for="fne_api_key" class="col-lg-4 o_light_label"/>
                                <field name="fne_api_key" password="True"/>
                            </div>
                            <div class="row">
                                <label for="fne_ncc" class="col-lg-4 o_light_label"/>
                                <field name="fne_ncc" placeholder="9606123E"/>
                            </div>
                            <div class="row">
                                <label for="fne_point_of_sale" class="col-lg-4 o_light_label"/>
                                <field name="fne_point_of_sale"/>
                            </div>
                            <div class="row">
                                <label for="fne_establishment" class="col-lg-4 o_light_label"/>
                                <field name="fne_establishment"/>
                            </div>
                            <div class="row">
                                <label for="fne_timeout" class="col-lg-4 o_light_label"/>
                                <field name="fne_timeout"/>
                            </div>
                            <div class="row">
                                <label for="fne_sticker_threshold" class="col-lg-4 o_light_label"/>
                                <field name="fne_sticker_threshold"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="fne_behaviour_setting"
                             string="Comportement à la validation"
                             invisible="not fne_enabled">
                        <field name="fne_certify_on_post"/>
                        <span class="ms-2">Certifier automatiquement à la validation</span>
                        <div class="mt8">
                            <field name="fne_block_on_error"/>
                            <span class="ms-2">Annuler la validation si la FNE refuse la facture</span>
                        </div>
                    </setting>
                    <setting id="fne_message_setting"
                             string="Mentions sur la facture"
                             invisible="not fne_enabled">
                        <div class="content-group">
                            <div class="row">
                                <label for="fne_commercial_message" class="col-lg-4 o_light_label"/>
                                <field name="fne_commercial_message"/>
                            </div>
                            <div class="row">
                                <label for="fne_footer" class="col-lg-4 o_light_label"/>
                                <field name="fne_footer"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
