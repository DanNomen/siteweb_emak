<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_fne" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="after">
            <!-- Instructions de paiement (ex. Orange Money) : mention libre saisie
                 dans Paramètres > Comptabilité > FNE. Imprimée avant le tableau des
                 lignes, comme sur la facture normalisée de référence. Les retours à
                 la ligne du champ sont rendus en <br/> par le convertisseur t-field
                 des champs Text, d'où la saisie sur plusieurs lignes possible. -->
            <div class="row mt-3" t-if="o.company_id.fne_payment_instruction">
                <div class="col-12">
                    <div class="border rounded d-inline-block px-2 py-1">
                        <span t-field="o.company_id.fne_payment_instruction"/>
                    </div>
                </div>
            </div>

            <div class="row mt-3" t-if="o.fne_reference">
                <div class="col-8">
                    <strong>Facture Normalisée Électronique</strong>
                    <div>
                        N° légal FNE : <span t-field="o.fne_reference"/>
                    </div>
                    <div t-if="o.company_id.fne_ncc">
                        NCC émetteur : <span t-field="o.company_id.fne_ncc"/>
                    </div>
                    <div t-if="o.partner_id.fne_ncc">
                        NCC client : <span t-field="o.partner_id.fne_ncc"/>
                    </div>
                    <div t-if="o.company_id.fne_commercial_message">
                        <span t-field="o.company_id.fne_commercial_message"/>
                    </div>
                </div>
                <div class="col-4 text-end">
                    <img t-if="o.fne_qr_image"
                         t-att-src="image_data_uri(o.fne_qr_image)"
                         style="max-height:120px;"
                         alt="QR code FNE"/>
                </div>
            </div>
        </xpath>
    </template>

    <!-- =====================================================================
         Mention légale de pied de page (capital social, adresse, RCCM...).

         Elle était auparavant insérée après //div[@id='total'], donc DANS le
         flux du document : sur une facture bien remplie elle débordait sur une
         page supplémentaire quasi vide au lieu de rester en bas de page.

         wkhtmltopdf ne répète en bas de chaque page que ce qui se trouve dans
         le bloc .footer de l'external_layout : c'est donc là qu'il faut la
         mettre. Les 7 layouts standard d'Odoo sont patchés ci-dessous ; tous
         rendent company.report_footer, ce qui donne un point d'ancrage commun.

         Le noeud d'origine est enveloppé ($0 = noeud remplacé) plutôt que la
         mention insérée en frère : dans les layouts 'standard' et 'folder' le
         pied est un conteneur d-flex, où un frère se placerait À CÔTÉ du texte
         au lieu d'en dessous. Le wrapper porte flex-grow-1 pour reprendre le
         rôle de l'élément d'origine dans ces deux layouts ; cette classe est
         sans effet dans les cinq autres, dont le parent n'est pas un flex.
         ===================================================================== -->
    <template id="fne_footer_mention">
        <div t-if="company.fne_footer" class="fne_footer_mention" style="font-size: 9px;">
            <span t-field="company.fne_footer"/>
        </div>
    </template>

    <template id="external_layout_standard_fne" inherit_id="web.external_layout_standard">
        <xpath expr="//*[@t-field='company.report_footer']" position="replace">
            <div class="flex-grow-1">
                <t>$0</t>
                <t t-call="fne_connector.fne_footer_mention"/>
            </div>
        </xpath>
    </template>

    <template id="external_layout_boxed_fne" inherit_id="web.external_layout_boxed">
        <xpath expr="//*[@t-field='company.report_footer']" position="replace">
            <div class="flex-grow-1">
                <t>$0</t>
                <t t-call="fne_connector.fne_footer_mention"/>
            </div>
        </xpath>
    </template>

    <template id="external_layout_bold_fne" inherit_id="web.external_layout_bold">
        <xpath expr="//*[@t-field='company.report_footer']" position="replace">
            <div class="flex-grow-1">
                <t>$0</t>
                <t t-call="fne_connector.fne_footer_mention"/>
            </div>
        </xpath>
    </template>

    <template id="external_layout_striped_fne" inherit_id="web.external_layout_striped">
        <xpath expr="//*[@t-field='company.report_footer']" position="replace">
            <div class="flex-grow-1">
                <t>$0</t>
                <t t-call="fne_connector.fne_footer_mention"/>
            </div>
        </xpath>
    </template>

    <template id="external_layout_folder_fne" inherit_id="web.external_layout_folder">
        <xpath expr="//*[@t-field='company.report_footer']" position="replace">
            <div class="flex-grow-1">
                <t>$0</t>
                <t t-call="fne_connector.fne_footer_mention"/>
            </div>
        </xpath>
    </template>

    <template id="external_layout_wave_fne" inherit_id="web.external_layout_wave">
        <xpath expr="//*[@t-field='company.report_footer']" position="replace">
            <div class="flex-grow-1">
                <t>$0</t>
                <t t-call="fne_connector.fne_footer_mention"/>
            </div>
        </xpath>
    </template>

    <template id="external_layout_bubble_fne" inherit_id="web.external_layout_bubble">
        <xpath expr="//*[@t-field='company.report_footer']" position="replace">
            <div class="flex-grow-1">
                <t>$0</t>
                <t t-call="fne_connector.fne_footer_mention"/>
            </div>
        </xpath>
    </template>
</odoo>
