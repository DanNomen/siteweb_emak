<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <!-- The gl_template_new template for the GeneralLedger component. -->
    <t t-name="gl_template_new" owl="1">
        <div class="o_action o_view_controller">
            <div class="o_content">
                <div class="fin_report">

                    <!-- ===== TOP BAR: Title + Buttons + Filters ===== -->
                    <div class="filter_view_gl" style="padding: 12px 20px 0 20px;">

                        <!-- Title -->
                        <h2 class="text-uppercase" style="padding: 6px 0 10px 0; font-size: 1.1rem; font-weight: 700;">
                            <t t-if="state.title">
                                <t t-esc="state.title"/>
                            </t>
                            <t t-else=" ">
                                <t t-esc="props.action.name"/>
                            </t>
                        </h2>

                        <!-- Buttons LEFT + Filters RIGHT on same row -->
                        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding-bottom: 12px; border-bottom: 1px solid #dee2e6;">

                            <!-- LEFT: Print + Export buttons -->
                            <div class="report_print" style="display: flex; gap: 8px;">
                                <button type="button"
                                        class="btn btn-primary btn-report-print"
                                        t-on-click="printPdf">
                                    <i class="fa fa-print" style="margin-right: 4px;"/>
                                    Imprimer (PDF)
                                </button>
                                <button type="button"
                                        class="btn btn-primary btn-report-print"
                                        t-on-click="print_xlsx">
                                    <i class="fa fa-download" style="margin-right: 4px;"/>
                                    Exporter (XLSX)
                                </button>
                            </div>

                            <!-- RIGHT: Filters -->
                            <div style="display: flex; align-items: center; gap: 4px; flex-wrap: wrap;">

                                <!-- Date Range -->
                                <div class="dropdown" style="position: relative;">
                                    <a type="button" class="dropdown-toggle btn btn-sm btn-light"
                                       data-bs-toggle="dropdown"
                                       t-att-class="state.date_range ? 'dropdown-toggle btn btn-sm btn-primary' : 'dropdown-toggle btn btn-sm btn-light'"
                                       style="display: flex; align-items: center; gap: 4px;">
                                        <span class="fa fa-calendar" role="img" aria-label="Dates"/>
                                        <t t-if="state.date_label">
                                            <t t-esc="state.date_label"/>
                                        </t>
                                        <t t-elif="state.date_range and state.date_range.start_date and state.date_range.end_date">
                                            Du <t t-esc="state.date_range.start_date"/> au <t t-esc="state.date_range.end_date"/>
                                        </t>
                                        <t t-elif="state.date_range and state.date_range.start_date">
                                            Depuis <t t-esc="state.date_range.start_date"/>
                                        </t>
                                        <t t-elif="state.date_range and state.date_range.end_date">
                                            Jusqu'au <t t-esc="state.date_range.end_date"/>
                                        </t>
                                        <t t-else="">Plage de dates</t>
                                    </a>
                                    <div class="dropdown-menu" role="menu" style="min-width: 220px; padding: 8px;">
                                        <div class="list-group list-group-flush">
                                            <button class="report-filter-button" t-att-data-value="'month'" type="button" t-on-click="applyFilter">Ce mois</button>
                                            <button class="report-filter-button" t-att-data-value="'quarter'" type="button" t-on-click="applyFilter">Ce trimestre</button>
                                            <button class="report-filter-button" t-att-data-value="'year'" type="button" t-on-click="applyFilter">Cette année</button>
                                            <div role="separator" class="dropdown-divider"/>
                                            <button class="report-filter-button" t-att-data-value="'last-month'" type="button" t-on-click="applyFilter">Mois dernier</button>
                                            <button class="report-filter-button" t-att-data-value="'last-quarter'" type="button" t-on-click="applyFilter">Trimestre dernier</button>
                                            <button class="report-filter-button" t-att-data-value="'last-year'" type="button" t-on-click="applyFilter">Année dernière</button>
                                            <div role="separator" class="dropdown-divider"/>
                                            <label for="start_date" style="font-size:0.82em; margin-bottom:2px; display:block;">Date de début :</label>
                                            <input type="date" id="start_date" t-on-change="applyFilter"
                                                   style="border:none;border-bottom: 1px solid #000;padding: 5px;outline: none; width:100%;"
                                                   name="start_date"/>
                                            <label for="end_date" style="font-size:0.82em; margin-top:6px; margin-bottom:2px; display:block;">Date de fin :</label>
                                            <input type="date" id="end_date" t-on-change="applyFilter"
                                                   style="border:none;border-bottom: 1px solid #000;padding: 5px;outline: none; width:100%;"
                                                   name="end_date"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Journals -->
                                <div class="dropdown" style="position: relative;">
                                    <a type="button" class="dropdown-toggle btn btn-sm btn-light"
                                       data-bs-toggle="dropdown" style="display: flex; align-items: center; gap: 4px; min-width: 100px;">
                                        <span class="fa fa-book" role="img"/>
                                        Journaux
                                        <t t-if="state.selected_journal_list and state.selected_journal_list.length > 0">
                                            : <t t-foreach="state.selected_journal_list" t-as="Journal_key" t-key="Journal_key_index">
                                                <t t-foreach="state.journals" t-as="Journal" t-key="Journal_index">
                                                    <t t-if="Journal['id'] == Journal_key">
                                                        <span><t t-esc="Journal['name']"/></span>
                                                    </t>
                                                </t>
                                                <t t-if="Journal_key_index != Object.keys(state.selected_journal_list).length - 1">, </t>
                                            </t>
                                        </t>
                                    </a>
                                    <ul class="dropdown-menu" role="menu" style="min-width: 200px; padding: 8px;">
                                        <div class="list-group list-group-flush">
                                            <t t-if="state.journals">
                                                <t t-foreach="state.journals" t-as="journal" t-key="journal.id">
                                                    <button class="report-filter-button"
                                                            t-att-data-value="'journal'"
                                                            t-att-data-id="journal.id"
                                                            aria-expanded="false"
                                                            type="button"
                                                            data-bs-auto-close="outside"
                                                            t-on-click="applyFilter">
                                                        <t t-esc="journal.name"/>
                                                    </button>
                                                </t>
                                            </t>
                                        </div>
                                    </ul>
                                </div>

                                <!-- Analytic -->
                                <div class="dropdown" style="position: relative;">
                                    <a type="button" class="dropdown-toggle btn btn-sm btn-light"
                                       data-bs-toggle="dropdown" style="display: flex; align-items: center; gap: 4px; min-width: 100px;">
                                        <span class="fa fa-book" role="img"/>
                                        Analytique
                                        <t t-if="state.selected_analytic_list and state.selected_analytic_list.length > 0">
                                            : <t t-foreach="state.selected_analytic_list" t-as="Analytic_key" t-key="Analytic_key_index">
                                                <t t-foreach="state.analytics" t-as="Analytic" t-key="Analytic_index">
                                                    <t t-if="Analytic['id'] == Analytic_key">
                                                        <span><t t-esc="Analytic['name']"/></span>
                                                    </t>
                                                </t>
                                                <t t-if="Analytic_key_index != Object.keys(state.selected_analytic_list).length - 1">, </t>
                                            </t>
                                        </t>
                                    </a>
                                    <div class="dropdown-menu" role="menu" style="min-width: 200px; padding: 8px;">
                                        <div class="list-group list-group-flush">
                                            <t t-if="state.analytics">
                                                <t t-foreach="state.analytics" t-as="analytic" t-key="analytic.id">
                                                    <button class="report-filter-button"
                                                            t-att-data-value="'analytic'"
                                                            t-att-data-id="analytic.id"
                                                            type="button"
                                                            t-on-click="applyFilter">
                                                        <t t-esc="analytic.name"/>
                                                    </button>
                                                </t>
                                            </t>
                                        </div>
                                    </div>
                                </div>

                                <!-- Options -->
                                <div class="dropdown" style="position: relative;">
                                    <a type="button" class="dropdown-toggle btn btn-sm btn-light"
                                       data-bs-toggle="dropdown" style="display: flex; align-items: center; gap: 4px;">
                                        <span class="fa fa-filter" role="img" aria-label="Options"/>
                                        Options : Entrées publiées,
                                        <t t-esc="Object.keys(state.method)[(Object.keys(state.method).length)-1]"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu" style="min-width: 200px; padding: 8px;">
                                        <div class="list-group list-group-flush">
                                            <button class="report-filter-button" t-att-data-value="'draft'" type="button" t-on-click="applyFilter">
                                                Inclure les brouillons
                                            </button>
                                            <button class="report-filter-button" type="button" t-ref="unfoldButton" t-on-click="unfoldAll">
                                                Tout déplier
                                            </button>
                                            <button class="report-filter-button" t-att-data-value="'cash-basis'" type="button" t-on-click="applyFilter">
                                                Méthode de caisse
                                            </button>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- ===== TABLE ===== -->
                    <div class="table_view_gl" t-ref="table_view_gl" style="padding: 0 20px 20px 20px;">
                        <div class="table_main_view">
                            <table cellspacing="0" width="100%" style="border-collapse: collapse;">
                                <thead style="position: sticky; top: 0; z-index: 1; background: white;">
                                    <tr class="o_heading" style="border-bottom: 2px solid #dee2e6;">
                                        <th colspan="6"/>
                                        <th style="padding: 8px 6px; white-space: nowrap;">Date</th>
                                        <th style="padding: 8px 6px;">Communication</th>
                                        <th style="padding: 8px 6px;">Partenaire</th>
                                        <th style="padding: 8px 6px; text-align: right;">Débit</th>
                                        <th style="padding: 8px 6px; text-align: right;">Crédit</th>
                                        <th style="padding: 8px 6px; text-align: right;">
                                            Équilibre
                                            <i class="fa fa-caret-up" style="margin-left:4px;"/>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody t-ref="tbody">

                                    <t t-if="state.account_data">

                                        <t t-set="i" t-value="0"/>
                                        <t t-foreach="state.account_data.account_totals"
                                           t-as="account"
                                           t-key="account_index">
                                            <t t-set="i" t-value="i + 1"/>

                                            <!-- Account Header Row -->
                                            <tr class="o_heading" style="border-bottom: 1px solid #dee2e6; background: #f8f9fa;">
                                                <th style="padding: 6px 4px;">
                                                    <div class="ms-3"
                                                         style="cursor: pointer;"
                                                         t-on-click="(ev) => this.expandAccount(ev, account)">
                                                        <a class="btn header o_heading" style="padding: 2px 4px; font-weight: 600; font-size: 0.9rem;">
                                                            <span class="toggle-icon">
                                                                <i class="fa fa-caret-down"/>
                                                            </span>
                                                            <t t-if="account != 'false'">
                                                                <t t-esc="account"/>
                                                            </t>
                                                            <t t-else="">
                                                                <span>Comptes inconnus</span>
                                                            </t>
                                                        </a>
                                                    </div>
                                                </th>
                                                <th colspan="5" style="padding: 6px 4px;">
                                                    <button t-att-data-id="state.account_data.account_totals[account]['account_id']"
                                                            class="btn btn-secondary btn-sm"
                                                            style="margin-left: 3px; font-size: 0.8rem;"
                                                            t-on-click="gotoJournalItem">
                                                        <i class="fa fa-arrow-right" style="margin-right: 3px;"/>
                                                        Éléments du journal
                                                    </button>
                                                </th>
                                                <th style="padding: 6px 4px;"/>
                                                <th style="padding: 6px 4px;"/>
                                                <th style="padding: 6px 4px;"/>
                                                <th style="padding: 6px 4px; text-align: right;">
                                                    <span>
                                                        <t t-if="state.account_data.account_totals[account]['total_debit']"
                                                           t-esc="state.account_data.account_totals[account]['total_debit_display']"/>
                                                    </span>
                                                </th>
                                                <th style="padding: 6px 4px; text-align: right;">
                                                    <span>
                                                        <t t-if="state.account_data.account_totals[account]['total_credit']"
                                                           t-esc="state.account_data.account_totals[account]['total_credit_display']"/>
                                                    </span>
                                                </th>
                                                <th style="padding: 6px 4px; text-align: right;">
                                                    <span class="fw-bolder">
                                                        <t t-esc="state.account_data.account_totals[account]['balance_display']"/>
                                                    </span>
                                                </th>
                                            </tr>

                                            <!-- Detail Lines -->
                                            <t t-if="state.account_total[account]._loading">
                                                <tr class="collapse" t-attf-id="account-{{i}}">
                                                    <th colspan="9" style="text-align: center; padding: 10px; font-weight: normal; font-size: 0.85rem;">
                                                        <i class="fa fa-spinner fa-spin"/> Chargement...
                                                    </th>
                                                </tr>
                                            </t>
                                            <t t-if="state.account_total[account]._lines_loaded and state.account_total[account]._expanded">
                                                <t t-foreach="state.account_total[account]._lines"
                                                   t-as="line"
                                                   t-key="line_index">
                                                    <tr class="border-bottom border-gainsboro"
                                                        style="border-bottom: 1px solid #f0f0f0;">
                                                        <th colspan="6" style="padding: 5px 4px 5px 28px;">
                                                            <span style="gap: 12px; display: flex; align-items: center;">
                                                                <t t-esc="line['move_name']"/>
                                                                <a type="button"
                                                                   class="dropdown-toggle"
                                                                   data-bs-toggle="dropdown"
                                                                   style="font-size: 0.75rem; opacity: 0.6;">
                                                                </a>
                                                                <div class="dropdown-menu journals">
                                                                    <button t-att-data-id="line['move_id'][0]"
                                                                            type="button"
                                                                            t-on-click="gotoJournalEntry"
                                                                            style="border: none; background-color: inherit; padding: 4px 8px; font-size: 14px; cursor: pointer; display: inline-block;">
                                                                        Voir l'écriture
                                                                    </button>
                                                                </div>
                                                            </span>
                                                        </th>
                                                        <th style="padding: 5px 6px; white-space: nowrap; font-size: 0.85rem;">
                                                            <t t-esc="line['date']"/>
                                                        </th>
                                                        <th style="padding: 5px 6px; font-size: 0.85rem;">
                                                            <t t-esc="line['name']"/>
                                                        </th>
                                                        <th style="padding: 5px 6px; font-size: 0.85rem;">
                                                            <t t-if="line['partner_id']"
                                                               t-esc="line['partner_id'][1]"/>
                                                        </th>
                                                        <th style="padding: 5px 6px; text-align: right; font-size: 0.85rem;">
                                                            <t t-if="line['debit']"
                                                               t-esc="this.formatNumberWithSeparators(line['debit'])"/>
                                                        </th>
                                                        <th style="padding: 5px 6px; text-align: right; font-size: 0.85rem;">
                                                            <t t-if="line['credit']"
                                                               t-esc="this.formatNumberWithSeparators(line['credit'])"/>
                                                        </th>
                                                        <th style="padding: 5px 6px;"/>
                                                    </tr>
                                                </t>
                                            </t>

                                        </t>
                                    </t>

                                    <!-- Total Row -->
                                    <tr style="border-top: 2px solid #dee2e6; background: #f8f9fa;">
                                        <th style="padding: 8px 4px;"/>
                                        <th colspan="8" class="o_heading" style="padding: 8px 6px; font-weight: 700;">
                                            Total
                                        </th>
                                        <th class="o_heading" style="padding: 8px 6px; text-align: right; font-weight: 700;">
                                            <t t-out="state.total_debit_display"/>
                                        </th>
                                        <th class="o_heading" style="padding: 8px 6px; text-align: right; font-weight: 700;">
                                            <t t-out="state.total_credit_display"/>
                                        </th>
                                        <th class="o_heading" style="padding: 8px 6px; text-align: right; font-weight: 700;">
                                            <t t-out="this.formatNumberWithSeparators(state.total_debit - state.total_credit)"/>
                                        </th>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </t>
</templates>
