<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <!--
    The pl_template_new template for the PartnerLedger component.
    @param {Object} state - The state object containing the component's state data.
    -->
    <t t-name="pl_template_new" owl="1">
        <div class="o_action o_view_controller">
            <div class="o_content">
                <div class="fin_report">

                    <!-- ===== TOP BAR: Title + Buttons + Filters ===== -->
                    <div class="filter_view_pl" style="padding: 12px 20px 0 20px;">

                        <!-- Title -->
                        <h2 class="text-uppercase" style="padding: 6px 0 10px 0; font-size: 1.1rem; font-weight: 700;">
                            <t t-esc="props.action.name"/>
                        </h2>

                        <!-- Buttons LEFT + Filters RIGHT on same row -->
                        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding-bottom: 12px; border-bottom: 1px solid #dee2e6;">

                            <!-- LEFT: Print + Export buttons -->
                            <div class="report_print" style="display: flex; gap: 8px;">
                                <button type="button"
                                        class="btn btn-primary btn-report-print"
                                        t-on-click="printPdf">
                                    <i class="fa fa-print" style="margin-right: 4px;"/>
                                    Imprimer (PDF)
                                </button>
                                <button type="button"
                                        class="btn btn-primary btn-report-print"
                                        t-on-click="print_xlsx">
                                    <i class="fa fa-download" style="margin-right: 4px;"/>
                                    Exporter (XLSX)
                                </button>
                            </div>

                            <!-- RIGHT: Filters -->
                            <div style="display: flex; align-items: center; gap: 4px; flex-wrap: wrap;">

                                <!-- Date Range -->
                                <div class="dropdown" style="position: relative;">
                                    <a type="button" class="dropdown-toggle btn btn-sm btn-light"
                                       data-bs-toggle="dropdown"
                                       style="display: flex; align-items: center; gap: 4px;">
                                        <span class="fa fa-calendar" role="img" aria-label="Dates"/>
                                        Plage de dates
                                    </a>
                                    <div class="dropdown-menu" role="menu" style="min-width: 220px; padding: 8px;">
                                        <div class="list-group list-group-flush">
                                            <button class="report-filter-button" t-att-data-value="'month'" type="button" t-on-click="applyFilter">Ce mois</button>
                                            <button class="report-filter-button" t-att-data-value="'quarter'" type="button" t-on-click="applyFilter">Ce trimestre</button>
                                            <button class="report-filter-button" t-att-data-value="'year'" type="button" t-on-click="applyFilter">Cette année</button>
                                            <div role="separator" class="dropdown-divider"/>
                                            <button class="report-filter-button" t-att-data-value="'last-month'" type="button" t-on-click="applyFilter">Mois dernier</button>
                                            <button class="report-filter-button" t-att-data-value="'last-quarter'" type="button" t-on-click="applyFilter">Trimestre dernier</button>
                                            <button class="report-filter-button" t-att-data-value="'last-year'" type="button" t-on-click="applyFilter">Année dernière</button>
                                            <div role="separator" class="dropdown-divider"/>
                                            <label for="start_date" style="font-size:0.82em; margin-bottom:2px; display:block;">Date de début :</label>
                                            <div class="input-group date" t-ref="date_from" data-target-input="nearest">
                                                <input type="date" id="start_date" t-on-change="applyFilter"
                                                       style="border:none;border-bottom: 1px solid #000;padding: 5px;outline: none; width:100%;"
                                                       name="start_date"/>
                                            </div>
                                            <label for="end_date" style="font-size:0.82em; margin-top:6px; margin-bottom:2px; display:block;">Date de fin :</label>
                                            <div class="input-group date" t-ref="date_to" data-target-input="nearest">
                                                <input type="date" id="end_date" t-on-change="applyFilter"
                                                       style="border:none;border-bottom: 1px solid #000;padding: 5px;outline: none; width:100%;"
                                                       name="end_date"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Account Type -->
                                <div class="dropdown" style="position: relative;">
                                    <a type="button" class="dropdown-toggle btn btn-sm btn-light"
                                       data-bs-toggle="dropdown" style="display: flex; align-items: center; gap: 4px; min-width: 100px;">
                                        <span class="fa fa-user" role="img" aria-label="Dates"/>
                                        Type de compte
                                        <t t-if="state.account and state.account.length">
                                            : <t t-foreach="state.account"
                                               t-as="account_key"
                                               t-key="account_key_index">
                                                <t t-esc="account_key"/>
                                                <t t-if="account_key_index != Object.keys(state.account).length - 1">, </t>
                                            </t>
                                        </t>
                                    </a>
                                    <div class="dropdown-menu" role="menu" style="min-width: 200px; padding: 8px;">
                                        <div class="list-group list-group-flush">
                                            <button class="report-filter-button" t-att-data-value="'receivable'" type="button" t-on-click="applyFilter">
                                                Client (recevable)
                                            </button>
                                            <button class="report-filter-button" t-att-data-value="'payable'" type="button" t-on-click="applyFilter">
                                                Fournisseur (payable)
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Partners -->
                                <div class="dropdown" style="position: relative;">
                                    <a type="button" class="dropdown-toggle btn btn-sm btn-light"
                                       data-bs-toggle="dropdown" style="display: flex; align-items: center; gap: 4px; min-width: 100px;">
                                        <span class="fa fa-users" role="img" aria-label="Partners"/>
                                        Partenaires
                                        <t t-if="state.selected_partner_rec and state.selected_partner_rec.length > 0">
                                            : <t t-foreach="state.selected_partner_rec" t-as="partner_rec"
                                               t-key="partner_rec_index">
                                                <t t-esc="partner_rec.display_name || partner_rec.name"/>
                                                <t t-if="partner_rec_index != state.selected_partner_rec.length - 1">, </t>
                                            </t>
                                        </t>
                                    </a>
                                    <div class="dropdown-menu partner-dropdown" role="menu"
                                         style="width: 300px; max-height: 350px; overflow-y: auto; padding: 8px;">
                                        <div class="list-group list-group-flush">
                                            <!-- Search Input -->
                                            <div class="mb-2">
                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       placeholder="Rechercher un partenaire..."
                                                       t-ref="partnerSearch"
                                                       t-on-input="searchPartners"
                                                       style="border: 1px solid #ccc; padding: 5px; font-size: 13px;"/>
                                            </div>
                                            <t t-if="state.selected_partner_rec and state.selected_partner_rec.length > 0">
                                                <div class="mb-2" style="max-height: 80px; overflow-y: auto;">
                                                    <small class="text-muted">
                                                        <strong>Sélectionnés :</strong>
                                                    </small>
                                                    <div class="mt-1">
                                                        <t t-foreach="state.selected_partner_rec" t-as="selected"
                                                           t-key="selected_index">
                                                            <span class="badge bg-primary me-1 mb-1"
                                                                  style="display: inline-flex; align-items: center; font-size: 11px;">
                                                                <t t-esc="selected.display_name || selected.name"/>
                                                                <i class="fa fa-times ms-1"
                                                                   style="cursor: pointer; font-size: 10px;"
                                                                   t-att-data-partner-id="selected.id"
                                                                   t-on-click="removePartner"/>
                                                            </span>
                                                        </t>
                                                    </div>
                                                </div>
                                                <div role="separator" class="dropdown-divider"/>
                                            </t>
                                            <!-- Partner List -->
                                            <div class="partner-list" style="max-height: 180px; overflow-y: auto;">
                                                <t t-if="state.filtered_partners and state.filtered_partners.length > 0">
                                                    <t t-foreach="state.filtered_partners" t-as="partner"
                                                       t-key="partner_index">
                                                        <button class="dropdown-item partner-item"
                                                                type="button"
                                                                t-att-data-partner-id="partner.id"
                                                                t-att-data-partner-name="partner.display_name || partner.name"
                                                                t-on-click="selectPartner"
                                                                style="width: 100%; text-align: left; padding: 6px 10px; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                            <t t-esc="partner.display_name || partner.name"/>
                                                        </button>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <div class="text-muted p-2" style="font-size: 12px;">Aucun partenaire trouvé
                                                    </div>
                                                </t>
                                            </div>
                                            <t t-if="state.selected_partner_rec and state.selected_partner_rec.length > 0">
                                                <div role="separator" class="dropdown-divider"/>
                                                <button class="btn btn-sm btn-danger w-100 mt-2"
                                                        type="button"
                                                        t-on-click="clearAllPartners"
                                                        style="font-size: 12px; padding: 4px;">
                                                    Tout effacer
                                                </button>
                                            </t>
                                        </div>
                                    </div>
                                </div>

                                <!-- Partner Tags -->
                                <div class="dropdown" style="position: relative;">
                                    <a type="button" class="dropdown-toggle btn btn-sm btn-light"
                                       data-bs-toggle="dropdown" style="display: flex; align-items: center; gap: 4px; min-width: 100px;">
                                        <span class="fa fa-filter" role="img" aria-label="Partner Tags"/>
                                        Étiquettes
                                        <t t-if="state.selected_tags and state.selected_tags.length > 0">
                                            (<t t-esc="state.selected_tags.length"/>)
                                        </t>
                                    </a>
                                    <div class="dropdown-menu category-dropdown" role="menu"
                                         style="width: 280px; max-height: 350px; overflow-y: auto; padding: 8px;">
                                        <div class="list-group list-group-flush">
                                            <div class="mb-2">
                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       placeholder="Rechercher une étiquette..."
                                                       t-ref="tagSearch"
                                                       t-on-input="searchTags"
                                                       style="border: 1px solid #ccc; padding: 5px; font-size: 13px;"/>
                                            </div>

                                            <t t-if="state.selected_tags and state.selected_tags.length > 0">
                                                <div class="mb-2" style="max-height: 80px; overflow-y: auto;">
                                                    <small class="text-muted"><strong>Sélectionnées :</strong></small>
                                                    <div class="mt-1">
                                                        <t t-foreach="state.selected_tags" t-as="tag" t-key="tag_index">
                                                            <span class="badge bg-info me-1 mb-1"
                                                                  style="display: inline-flex; align-items: center; font-size: 11px;">
                                                                <t t-esc="tag.name"/>
                                                                <i class="fa fa-times ms-1"
                                                                   style="cursor: pointer; font-size: 10px;"
                                                                   t-att-data-tag-id="tag.id"
                                                                   t-on-click="removeTag"/>
                                                            </span>
                                                        </t>
                                                    </div>
                                                </div>
                                                <div role="separator" class="dropdown-divider"/>
                                            </t>

                                            <div class="tag-list" style="max-height: 180px; overflow-y: auto;">
                                                <t t-if="state.filtered_tags and state.filtered_tags.length > 0">
                                                    <t t-foreach="state.filtered_tags" t-as="tag" t-key="tag_index">
                                                        <button class="dropdown-item tag-item"
                                                                type="button"
                                                                t-att-data-tag-id="tag.id"
                                                                t-att-data-tag-name="tag.name"
                                                                t-on-click="selectTag"
                                                                style="width: 100%; text-align: left; padding: 6px 10px; font-size: 13px;">
                                                            <t t-esc="tag.name"/>
                                                        </button>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <div class="text-muted p-2" style="font-size: 12px;">Aucune étiquette trouvée</div>
                                                </t>
                                            </div>

                                            <t t-if="state.selected_tags and state.selected_tags.length > 0">
                                                <div role="separator" class="dropdown-divider"/>
                                                <button class="btn btn-sm btn-danger w-100 mt-2"
                                                        type="button"
                                                        t-on-click="clearAllTags"
                                                        style="font-size: 12px; padding: 4px;">
                                                    Tout effacer
                                                </button>
                                            </t>
                                        </div>
                                    </div>
                                </div>

                                <!-- Accounts -->
                                <div class="dropdown" style="position: relative;">
                                    <a type="button" class="dropdown-toggle btn btn-sm btn-light"
                                       data-bs-toggle="dropdown" style="display: flex; align-items: center; gap: 4px; min-width: 100px;">
                                        <span class="fa fa-book" role="img" aria-label="Accounts"/>
                                        Comptes
                                        <t t-if="state.selected_accounts and state.selected_accounts.length > 0">
                                            (<t t-esc="state.selected_accounts.length"/>)
                                        </t>
                                    </a>
                                    <div class="dropdown-menu account-dropdown" role="menu"
                                         style="width: 320px; max-height: 350px; overflow-y: auto; padding: 8px;">
                                        <div class="list-group list-group-flush">
                                            <div class="mb-2">
                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       placeholder="Rechercher un compte..."
                                                       t-ref="accountSearch"
                                                       t-on-input="searchAccounts"
                                                       style="border: 1px solid #ccc; padding: 5px; font-size: 13px;"/>
                                            </div>

                                            <t t-if="state.selected_accounts and state.selected_accounts.length > 0">
                                                <div class="mb-2" style="max-height: 80px; overflow-y: auto;">
                                                    <small class="text-muted"><strong>Sélectionnés :</strong></small>
                                                    <div class="mt-1">
                                                        <t t-foreach="state.selected_accounts" t-as="acc" t-key="acc_index">
                                                            <span class="badge bg-success me-1 mb-1"
                                                                  style="display: inline-flex; align-items: center; font-size: 11px;">
                                                                <t t-esc="acc.code"/> - <t t-esc="acc.name"/>
                                                                <i class="fa fa-times ms-1"
                                                                   style="cursor: pointer; font-size: 10px;"
                                                                   t-att-data-account-id="acc.id"
                                                                   t-on-click="removeAccount"/>
                                                            </span>
                                                        </t>
                                                    </div>
                                                </div>
                                                <div role="separator" class="dropdown-divider"/>
                                            </t>

                                            <div class="account-list" style="max-height: 180px; overflow-y: auto;">
                                                <t t-if="state.filtered_accounts and state.filtered_accounts.length > 0">
                                                    <t t-foreach="state.filtered_accounts" t-as="acc" t-key="acc_index">
                                                        <button class="dropdown-item account-item"
                                                                type="button"
                                                                t-att-data-account-id="acc.id"
                                                                t-att-data-account-code="acc.code"
                                                                t-att-data-account-name="acc.name"
                                                                t-on-click="selectAccount"
                                                                style="width: 100%; text-align: left; padding: 6px 10px; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                            <strong><t t-esc="acc.code"/></strong> - <t t-esc="acc.name"/>
                                                        </button>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <div class="text-muted p-2" style="font-size: 12px;">Aucun compte trouvé</div>
                                                </t>
                                            </div>

                                            <t t-if="state.selected_accounts and state.selected_accounts.length > 0">
                                                <div role="separator" class="dropdown-divider"/>
                                                <button class="btn btn-sm btn-danger w-100 mt-2"
                                                        type="button"
                                                        t-on-click="clearAllAccounts"
                                                        style="font-size: 12px; padding: 4px;">
                                                    Tout effacer
                                                </button>
                                            </t>
                                        </div>
                                    </div>
                                </div>

                                <!-- Options -->
                                <div class="dropdown" style="position: relative;">
                                    <a type="button" class="dropdown-toggle btn btn-sm btn-light"
                                       data-bs-toggle="dropdown" style="display: flex; align-items: center; gap: 4px;">
                                        <span class="fa fa-filter" role="img" aria-label="Options"/>
                                        Options : Entrées publiées
                                    </a>
                                    <div class="dropdown-menu" role="menu" style="min-width: 200px; padding: 8px;">
                                        <div class="list-group list-group-flush">
                                            <button class="report-filter-button" t-att-data-value="'draft'" type="button" t-on-click="applyFilter">
                                                Inclure les brouillons
                                            </button>
                                            <button class="report-filter-button" type="button" t-ref="unfoldButton" t-on-click="unfoldAll">
                                                Tout déplier
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Recherche : compte / contact / pièce -->
                                <ReportSearchBar onSearch.bind="onReportSearch"/>

                            </div>
                        </div>
                    </div>

                    <!-- ===== TABLE ===== -->
                    <div class="table_view_pl" t-ref="table_view_pl" style="padding: 0 20px 20px 20px;">
                        <div class="table_main_view">
                            <table cellspacing="0" width="100%" style="border-collapse: collapse;">
                                <thead style="position: sticky; top: 0; z-index: 1; background: white;">
                                    <tr class="o_heading" style="border-bottom: 2px solid #dee2e6;">
                                        <th colspan="6"/>
                                        <th style="padding: 8px 6px;">Journal</th>
                                        <th style="padding: 8px 6px;">Compte</th>
                                        <th style="padding: 8px 6px;">Réf.</th>
                                        <th style="padding: 8px 6px;">Échéance</th>
                                        <th style="padding: 8px 6px;">N° lettrage</th>
                                        <th style="padding: 8px 6px; text-align: right;">Débit</th>
                                        <th style="padding: 8px 6px; text-align: right;">Crédit</th>
                                        <th style="padding: 8px 6px; text-align: right;">Devise</th>
                                        <th style="padding: 8px 6px; text-align: right;">Solde</th>
                                    </tr>
                                </thead>
                                <tbody t-ref="tbody">
                                    <!-- Iterate over partners -->
                                    <t t-if="state.partners">
                                        <t t-foreach="state.partners"
                                           t-as="partner"
                                           t-key="partner_index">
                                            <t t-set="pdata" t-value="state.total[partner]"/>
                                            <t t-if="pdata and pdata['total_debit']">
                                                <!-- Partner summary row (clickable to expand) -->
                                                <tr class="border-bottom border-dark o_heading"
                                                    style="cursor:pointer;"
                                                    t-on-click="(ev) => this.expandPartner(ev, partner)">
                                                    <th colspan="2">
                                                        <span style="display:flex;align-items:center;gap:8px;padding-left:8px;">
                                                            <t t-if="pdata._loading">
                                                                <i class="fa fa-spinner fa-spin text-muted" style="font-size:12px;"/>
                                                            </t>
                                                            <t t-elif="pdata._expanded">
                                                                <i class="fa fa-caret-down" style="font-size:12px;"/>
                                                            </t>
                                                            <t t-else="">
                                                                <i class="fa fa-caret-right" style="font-size:12px;"/>
                                                            </t>
                                                            <t t-if="partner != 'false'">
                                                                <t t-esc="partner"/>
                                                            </t>
                                                            <t t-else="">Partenaire inconnu</t>
                                                        </span>
                                                    </th>
                                                    <th colspan="4" class="p-1">
                                                        <!-- Open Partner Button -->
                                                        <button t-att-data-id="pdata['partner_id']"
                                                                class="btn btn-sm btn-secondary"
                                                                t-on-click.stop="openPartner">
                                                            Ouvrir le partenaire
                                                        </button>
                                                        <!-- Journal Items Button -->
                                                        <button style="margin-left: 3px"
                                                                t-att-data-id="pdata['partner_id']"
                                                                class="btn btn-sm btn-secondary"
                                                                t-on-click.stop="gotoJournalItem">
                                                            Éléments du journal
                                                        </button>
                                                    </th>
                                                    <th/>
                                                    <th/>
                                                    <th/>
                                                    <th/>
                                                    <th/>
                                                    <th class="text-end">
                                                        <t t-esc="pdata['total_debit_display']"/>
                                                    </th>
                                                    <th class="text-end">
                                                        <t t-esc="pdata['total_credit_display']"/>
                                                    </th>
                                                    <th/>
                                                    <th class="text-end fw-bolder">
                                                        <t t-esc="pdata['balance_display']"/>
                                                    </th>
                                                </tr>

                                                <!-- Initial Balance row (shown when expanded) -->
                                                <t t-if="pdata._expanded and pdata['initial_balance'] != 0">
                                                    <tr class="border-bottom border-gainsboro" style="background:#f9f9f9;">
                                                        <td colspan="6" style="padding-left:24px;font-style:italic;color:#888;">
                                                            Solde initial
                                                        </td>
                                                        <td/>
                                                        <td/>
                                                        <td/>
                                                        <td/>
                                                        <td/>
                                                        <td class="text-end">
                                                            <t t-esc="pdata['initial_debit_display']"/>
                                                        </td>
                                                        <td class="text-end">
                                                            <t t-esc="pdata['initial_credit_display']"/>
                                                        </td>
                                                        <td/>
                                                        <td class="text-end">
                                                            <t t-esc="pdata['initial_balance_display']"/>
                                                        </td>
                                                    </tr>
                                                </t>

                                                <!-- Lazy-loaded move lines (shown when expanded) -->
                                                <t t-if="pdata._expanded">
                                                    <t t-foreach="pdata._lines" t-as="line" t-key="line_index">
                                                        <tr class="border-bottom border-gainsboro"
                                                            t-att-data-id="line['move_id'] and line['move_id'][0]">
                                                            <td colspan="6" style="padding-left:32px;">
                                                                <span style="display:flex;gap:12px;align-items:center;">
                                                                    <t t-esc="line['date']"/>
                                                                    <a type="button"
                                                                       class="dropdown-toggle"
                                                                       data-bs-toggle="dropdown"/>
                                                                    <div class="dropdown-menu journals">
                                                                        <button t-att-data-id="line['move_id'] and line['move_id'][0]"
                                                                                type="button"
                                                                                t-on-click="gotoJournalEntry"
                                                                                style="border:none;background:inherit;padding:4px 8px;cursor:pointer;">
                                                                            Voir l'écriture
                                                                        </button>
                                                                        <div role="separator" class="dropdown-divider"/>
                                                                    </div>
                                                                </span>
                                                            </td>
                                                            <td><t t-esc="line['jrnl']"/></td>
                                                            <td><t t-esc="line['code']"/></td>
                                                            <td><t t-esc="line['move_name']"/></td>
                                                            <td>
                                                                <t t-if="line['date_maturity']">
                                                                    <t t-esc="line['date_maturity']"/>
                                                                </t>
                                                            </td>
                                                            <td>
                                                                <t t-if="line['matching_number']">
                                                                    <t t-esc="line['matching_number']"/>
                                                                </t>
                                                            </td>
                                                            <td class="text-end">
                                                                <t t-if="line['debit']">
                                                                    <t t-esc="this.formatNumberWithSeparators(line['debit'])"/>
                                                                </t>
                                                            </td>
                                                            <td class="text-end">
                                                                <t t-if="line['credit']">
                                                                    <t t-esc="this.formatNumberWithSeparators(line['credit'])"/>
                                                                </t>
                                                            </td>
                                                            <td class="text-end">
                                                                <t t-if="line['amount_currency']">
                                                                    <t t-esc="this.formatNumberWithSeparators(line['amount_currency'])"/>
                                                                </t>
                                                            </td>
                                                            <td/>
                                                        </tr>
                                                    </t>
                                                </t>
                                            </t>
                                        </t>
                                    </t>
                                    <!-- Grand Total Row -->
                                    <tr class="o_heading">
                                        <th colspan="11">Total</th>
                                        <th class="text-end">
                                            <t t-out="state.total_debit_display"/>
                                        </th>
                                        <th class="text-end">
                                            <t t-out="state.total_credit_display"/>
                                        </th>
                                        <th/>
                                        <th class="text-end">
                                            <t t-if="state.total_debit and state.total_credit">
                                                <t t-esc="this.formatNumberWithSeparators(state.total_debit - state.total_credit)"/>
                                            </t>
                                        </th>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    </div>

                    <div class="foot_note">
                        <t t-set="count" t-value="1"/>
                        <t t-foreach="state.message_list" t-as="message"
                           t-key="message_index">
                            <t t-out="count"/>.
                            <t t-set="count" t-value="count + 1"/>
                            <t t-out="message['message']"/>
                            <i t-att-id="message['id']" style="margin-left: 1%;"
                               class="fa fa-trash"
                               t-on-click="deleteNote"/>
                            <br/>
                        </t>
                    </div>
                </div>
            </div>
    </t>
</templates>

