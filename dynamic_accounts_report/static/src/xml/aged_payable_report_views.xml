<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="age_p_template_new" owl="1">
        <!-- Section contains a structure for the Aged Payable report, including
        a filter view and a table view. It has div elements for the filter view
        and table view, with respective classes for styling.-->
        <div class="o_action o_view_controller">
            <div class="o_content">
                <div class="fin_report">

                    <!-- ===== TOP BAR: Title + Buttons + Filters ===== -->
                    <div class="filter_view_gl" style="padding: 12px 20px 0 20px;">

                        <!-- Title -->
                        <h2 class="text-uppercase" style="padding: 6px 0 10px 0; font-size: 1.1rem; font-weight: 700;">
                            <t t-esc="props.action.name"/>
                        </h2>

                        <!-- Buttons LEFT + Filters RIGHT on same row -->
                        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding-bottom: 12px; border-bottom: 1px solid #dee2e6;">

                            <!-- LEFT: Print + Export buttons -->
                            <div class="report_print" style="display: flex; gap: 8px;">
                                <button type="button"
                                        class="btn btn-primary btn-report-print"
                                        t-on-click="printPdf">
                                    <i class="fa fa-print" style="margin-right: 4px;"/>
                                    Imprimer (PDF)
                                </button>
                                <button type="button"
                                        class="btn btn-primary btn-report-print"
                                        t-on-click="print_xlsx">
                                    <i class="fa fa-download" style="margin-right: 4px;"/>
                                    Exporter (XLSX)
                                </button>
                            </div>

                            <!-- RIGHT: Filters -->
                            <div style="display: flex; align-items: center; gap: 4px; flex-wrap: wrap;">

                                <!-- Date -->
                                <div class="dropdown" style="position: relative;">
                                    <a type="button" class="dropdown-toggle btn btn-sm btn-light"
                                       data-bs-toggle="dropdown"
                                       style="display: flex; align-items: center; gap: 4px;">
                                        <span class="fa fa-calendar" role="img" aria-label="Dates"/>
                                        Plage de dates
                                    </a>
                                    <div class="dropdown-menu" role="menu" style="min-width: 220px; padding: 8px;">
                                        <div class="list-group list-group-flush">
                                            <button class="report-filter-button" t-att-data-value="'today'" type="button" t-on-click="applyFilter">Aujourd'hui</button>
                                            <button class="report-filter-button" t-att-data-value="'last-month-end'" type="button" t-on-click="applyFilter">Fin du mois dernier</button>
                                            <button class="report-filter-button" t-att-data-value="'last-quarter-end'" type="button" t-on-click="applyFilter">Fin du trimestre dernier</button>
                                            <button class="report-filter-button" t-att-data-value="'last-year-end'" type="button" t-on-click="applyFilter">Fin de l'année dernière</button>
                                            <div role="separator" class="dropdown-divider"/>
                                            <label for="end_date" style="font-size:0.82em; margin-bottom:2px; display:block;">Date :</label>
                                            <div class="input-group date" data-target-input="nearest">
                                                <input type="date" id="end_date"
                                                       t-ref="date_to"
                                                       t-on-input="applyFilter"
                                                       style="border:none;border-bottom: 1px solid #000;padding: 5px;outline: none; width:100%;"
                                                       name="end_date"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Options -->
                                <div class="dropdown" style="position: relative;">
                                    <a type="button" class="dropdown-toggle btn btn-sm btn-light"
                                       data-bs-toggle="dropdown" style="display: flex; align-items: center; gap: 4px;">
                                        <span class="fa fa-filter" role="img" aria-label="Options"/>
                                        Options
                                    </a>
                                    <div class="dropdown-menu" role="menu" style="min-width: 200px; padding: 8px;">
                                        <div class="list-group list-group-flush">
                                            <button class="report-filter-button" type="button" t-ref="unfoldButton" t-on-click="unfoldAll">
                                                Tout déplier
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Recherche : compte / contact / pièce -->
                                <ReportSearchBar onSearch.bind="onReportSearch"/>

                            </div>
                        </div>
                    </div>

                    <!-- ===== TABLE ===== -->
                    <div class="table_view_gl" t-ref="table_view_gl" style="padding: 0 20px 20px 20px;">
                        <div class="table_main_view">
                            <table cellspacing="0" width="100%" style="border-collapse: collapse;">
                                <thead style="position: sticky; top: 0; z-index: 1; background: white;">
                                    <tr class="o_heading" style="border-bottom: 2px solid #dee2e6;">
                                        <th colspan="6"/>
                                        <th style="padding: 8px 6px;">Date facture</th>
                                        <th style="padding: 8px 6px;">Montant devise</th>
                                        <th style="padding: 8px 6px;">Devise</th>
                                        <th style="padding: 8px 6px;">Compte</th>
                                        <th style="padding: 8px 6px;">Date échéance</th>
                                        <th style="padding: 8px 6px;">À la date</th>
                                        <th style="padding: 8px 6px;">1-30</th>
                                        <th style="padding: 8px 6px;">31-60</th>
                                        <th style="padding: 8px 6px;">61-90</th>
                                        <th style="padding: 8px 6px;">91-120</th>
                                        <th style="padding: 8px 6px;">Plus ancien</th>
                                        <th style="padding: 8px 6px;">Total</th>
                                    </tr>
                                </thead>
                                <tbody t-ref="tbody">
                                        <t t-if="state.move_line and state.total">
                                            <t t-set="i" t-value="0"/>
                                            <t t-foreach="state.move_line"
                                               t-as="move_line"
                                               t-key="move_line_index">
                                                <t t-set="i" t-value="i + 1"/>
                                                <t t-if="state.total[move_line]">
                                                <tr class="border-bottom border-dark border-gainsboro">
                                                    <th>
                                                        <div data-bs-toggle="collapse"
                                                             t-attf-href="#move_line-{{i}}"
                                                             aria-expanded="false"
                                                             t-attf-aria-controls="move_line-{{i}}"
                                                             t-on-click="(ev) => this.expandPartner(ev, move_line)"
                                                             class="ms-3 collapsed">
                                                            <a class="btn header o_heading">
                                                                <span class="toggle-icon">
                                                                    <i class="fa fa-caret-down"/>
                                                                </span>
                                                                <t t-esc="move_line"/>
                                                            </a>
                                                        </div>
                                                    </th>
                                                    <th colspan="5">
                                                        <!-- Open Partner Button -->
                                                        <button t-att-data-id="state.total[move_line]['partner_id']"
                                                                class="btn btn-secondary btn-sm"
                                                                style="margin-left: 3px; font-size: 0.8rem;"
                                                                t-on-click="openPartner">
                                                            <i class="fa fa-arrow-right" style="margin-right: 3px;"/>
                                                            Ouvrir
                                                        </button>
                                                        <!-- Journal Items Button -->
                                                        <button t-att-data-id="state.total[move_line]['partner_id']"
                                                                class="btn btn-secondary btn-sm"
                                                                style="margin-left: 3px; font-size: 0.8rem;"
                                                                t-on-click="gotoJournalItem">
                                                            <i class="fa fa-arrow-right" style="margin-right: 3px;"/>
                                                            Éléments du journal
                                                        </button>
                                                    </th>
                                                    <th/>
                                                    <th/>
                                                    <th/>
                                                    <th/>
                                                    <th/>
                                                    <th>
                                                        <span>
                                                            <t t-if="state.total[move_line]['diff0_sum']"
                                                               t-esc="state.total[move_line]['diff0_sum_display']"/>
                                                        </span>
                                                    </th>
                                                    <th>
                                                        <span>
                                                            <t t-if="state.total[move_line]['diff1_sum']"
                                                               t-esc="state.total[move_line]['diff1_sum_display']"/>
                                                        </span>
                                                    </th>
                                                    <th>
                                                        <span>
                                                            <t t-if="state.total[move_line]['diff2_sum']"
                                                               t-esc="state.total[move_line]['diff2_sum_display']"/>
                                                        </span>
                                                    </th>
                                                    <th>
                                                        <span>
                                                            <t t-if="state.total[move_line]['diff3_sum']"
                                                               t-esc="state.total[move_line]['diff3_sum_display']"/>
                                                        </span>
                                                    </th>
                                                    <th>
                                                        <span>
                                                            <t t-if="state.total[move_line]['diff4_sum']"
                                                               t-esc="state.total[move_line]['diff4_sum_display']"/>
                                                        </span>
                                                    </th>
                                                    <th>
                                                        <span>
                                                            <t t-if="state.total[move_line]['diff5_sum']"
                                                               t-esc="state.total[move_line]['diff5_sum_display']"/>
                                                        </span>
                                                    </th>
                                                    <th>
                                                        <span>
                                                            <t t-if="state.total[move_line]['credit_sum']"
                                                               t-esc="state.total[move_line]['credit_sum_display']"/>
                                                        </span>
                                                    </th>
                                                </tr>
                                                <t t-foreach="state.total[move_line]['_lines']"
                                                   t-as="valuelist"
                                                   t-key="valuelist_index">
                                                    <tr class="border-bottom border-gainsboro collapse"
                                                        t-attf-id="move_line-{{i}}">
                                                        <th colspan="6">
                                                            <span style="gap: 12px;display: flex;">
                                                                <t t-esc="valuelist['move_name']"/>
                                                                <t t-esc="valuelist['name']"/>
                                                                <a type="button"
                                                                   class="dropdown-toggle"
                                                                   data-bs-toggle="dropdown">
                                                                </a>
                                                                <div class="dropdown-menu  journals">
                                                                    <button t-att-data-id="valuelist['move_id'][0]"
                                                                            type="button"
                                                                            t-on-click="gotoJournalEntry"
                                                                            style="border: none;
                                                                            background-color: inherit;
                                                                            padding: 4px 8px;
                                                                            font-size: 16px;
                                                                            cursor: pointer;
                                                                            display: inline-block;">
                                                                        Voir l'écriture
                                                                    </button>
                                                                </div>
                                                            </span>
                                                        </th>
                                                        <th>
                                                            <span>
                                                                <t t-esc="valuelist['date']"/>
                                                            </span>
                                                        </th>
                                                        <th>
                                                            <span>
                                                                <t t-esc="valuelist['amount_currency']"/>
                                                            </span>
                                                        </th>
                                                        <th>
                                                            <span>
                                                                <t t-esc="valuelist['currency_id'][1]"/>
                                                            </span>
                                                        </th>
                                                        <th>
                                                            <span>
                                                                <t t-esc="valuelist['account_id'][1]"/>
                                                            </span>
                                                        </th>
                                                        <th>
                                                            <span>
                                                                <t t-if="valuelist['date_maturity']"
                                                                   t-esc="valuelist['date_maturity']"/>
                                                            </span>
                                                        </th>
                                                        <th>
                                                            <span>
                                                                <t t-if="valuelist['diff0']"
                                                                   t-esc="this.formatNumberWithSeparators(valuelist['diff0'])"/>
                                                            </span>
                                                        </th>
                                                        <th>
                                                            <span>
                                                                <t t-if="valuelist['diff1']"
                                                                   t-esc="this.formatNumberWithSeparators(valuelist['diff1'])"/>
                                                            </span>
                                                        </th>
                                                        <th>
                                                            <span>
                                                                <t t-if="valuelist['diff2']"
                                                                   t-esc="this.formatNumberWithSeparators(valuelist['diff2'])"/>
                                                            </span>
                                                        </th>
                                                        <th>
                                                            <span>
                                                                <t t-if="valuelist['diff3']"
                                                                   t-esc="this.formatNumberWithSeparators(valuelist['diff3'])"/>
                                                            </span>
                                                        </th>
                                                        <th>
                                                            <span>
                                                                <t t-if="valuelist['diff4']"
                                                                   t-esc="this.formatNumberWithSeparators(valuelist['diff4'])"/>
                                                            </span>
                                                        </th>
                                                        <th>
                                                            <span>
                                                                <t t-if="valuelist['diff5']"
                                                                   t-esc="this.formatNumberWithSeparators(valuelist['diff5'])"/>
                                                            </span>
                                                        </th>
                                                        <th/>
                                                    </tr>
                                                </t>
                                                </t>
                                            </t>
                                        </t>
                                        <tr>
                                            <th/>
                                            <th colspan="10" class="o_heading">
                                                Total
                                            </th>
                                            <th class="o_heading">
                                                <t t-out="state.diff0_sum_display"/>
                                            </th>
                                            <th class="o_heading">
                                                <t t-out="state.diff1_sum_display"/>
                                            </th>
                                            <th class="o_heading">
                                                <t t-out="state.diff2_sum_display"/>
                                            </th>
                                            <th class="o_heading">
                                                <t t-out="state.diff3_sum_display"/>
                                            </th>
                                            <th class="o_heading">
                                                <t t-out="state.diff4_sum_display"/>
                                            </th>
                                            <th class="o_heading">
                                                <t t-out="state.diff5_sum_display"/>
                                            </th>
                                            <th class="o_heading">
                                                <t t-out="state.total_credit_display"/>
                                            </th>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    </t>
</templates>

