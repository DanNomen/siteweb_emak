<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Report Template for General Ledger-->
    <template id="general_ledger">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="data_report_margin_top" t-value="12"/>
                <t t-set="data_report_header_spacing" t-value="9"/>
                <t t-set="data_report_dpi" t-value="110"/>
                <div class="page">
                    <h3>
                        <center>
                            <b>
                                <span t-esc="report_name"/>
                            </b>
                        </center>
                    </h3>
                    <br/>
                    <br/>
                    <div class="filters">
                        <table class="table table-sm table-reports">
                            <thead class="filter_table"
                                   style="background:#808080;">
                                <tr>
                                    <th>Plage de dates</th>
                                    <th>Journal</th>
                                    <th>Analytique</th>
                                    <th>Options</th>
                                </tr>
                            </thead>
                            <tbody style="font-size:11px;font-weight:100;">
                                <tr>
                                    <th>
                                        <t t-if="filters['start_date'] or filters['end_date']">
                                            <t t-if="filters['start_date']"
                                               t-out="filters['start_date']"/>
                                            <t t-if="filters['end_date']">
                                                au
                                                <t t-out="filters['end_date']"/>
                                            </t>
                                        </t>
                                        <t t-else="">Toutes les dates</t>
                                    </th>
                                    <th>
                                        <t t-if="filters['journal']">
                                            <t t-set="first_journal" t-value="True"/>
                                            <t t-foreach="filters['journal']" t-as="selected_journal">
                                                <t t-if="not first_journal">,</t>
                                                <t t-out="selected_journal"/>
                                                <t t-set="first_journal" t-value="False"/>
                                            </t>
                                        </t>
                                        <t t-else="">Tous les journaux</t>
                                    </th>
                                    <th>
                                        <t t-if="filters['analytic']">
                                            <t t-set="first_account" t-value="True"/>
                                            <t t-foreach="filters['analytic']" t-as="selected_analytic_account">
                                                <t t-if="not first_account">,</t>
                                                <t t-out="selected_analytic_account"/>
                                                <t t-set="first_account" t-value="False"/>
                                            </t>
                                        </t>
                                        <t t-else="">Tous</t>
                                    </th>
                                    <th>
                                        <t t-if="filters['options']">
                                            Validées ,
                                        </t>
                                        <t t-else="">
                                            Validées
                                        </t>
                                        <t t-set="first_option" t-value="True"/>
                                        <t t-foreach="filters['options']" t-as="selected_options">
                                            <t t-if="not first_option">,</t>
                                            <t t-out="selected_options"/>
                                            <t t-set="first_option" t-value="False"/>
                                        </t>
                                    </th>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <br/>
                    <br/>
                    <br/>
                    <t t-if="account">
<!--                        <t t-foreach="account_data.account_totals"-->
<!--                           t-as="accounts"-->
<!--                           t-key="accounts_index">-->
                            <table class="table table-sm table-reports">
                                <thead style="background:#808080;">
                                    <tr>
                                        <th style="width:10%" colspan="6"/>
                                        <th style="width:10%">Date</th>
                                        <th style="width:10%">Communication
                                        </th>
                                        <th style="width:10%">Partenaire</th>
                                        <th style="width:10%">Débit</th>
                                        <th style="width:10%">Crédit</th>
                                        <th style="width:10%">Solde</th>
                                    </tr>
                                </thead>
                                <tbody style="font-size:11px;font-weight:100;">
                                    <t t-foreach="account"
                           t-as="account"
                           t-key="accounts_index">
                                    <tr class="border-bottom"
                                        style="background:#D3D3D3;">
                                        <th colspan="6">
                                            <div class="ms-3">
                                                <span class="fw-bolder">
                                                    <t t-if="accounts != 'false'">
                                                        <strong>
                                                            <b>
                                                                <t t-esc="account"/>
                                                            </b>
                                                        </strong>
                                                    </t>
                                                    <t t-else="">
                                                        <span>Compte
                                                            inconnu
                                                        </span>
                                                    </t>
                                                </span>
                                            </div>
                                        </th>
                                        <th style="width:10% border:0px solid transparent;"/>
                                        <th style="width:10% border:0px solid transparent;"/>
                                        <th style="width:10% border:0px solid transparent;"/>
                                        <th style="width:10% border:0px solid transparent;">
                                            <strong>
                                                <span>
                                                    <!-- Solde initial + mouvements de la période (pas
                                                         seulement les mouvements) : même formule que le
                                                         solde progressif détaillé plus bas. -->
                                                    <t t-if="total[account]['combined_debit']"
                                                       t-esc="total[account]['currency_id']"/>
                                                    <t t-if="total[account]['combined_debit']"
                                                       t-esc="total[account]['combined_debit']"/>
                                                </span>
                                            </strong>
                                        </th>
                                        <th style="width:10% border:0px solid transparent;">
                                            <strong>
                                                <span>
                                                    <t t-if="total[account]['combined_credit']"
                                                       t-esc="total[account]['currency_id']"/>
                                                    <t t-if="total[account]['combined_credit']"
                                                       t-esc="total[account]['combined_credit']"/>
                                                </span>
                                            </strong>
                                        </th>
                                        <th style="width:10% border:0px solid transparent;border-right: thin solid #dee2e6;">
                                            <strong>
                                                <span class="fw-bolder">
                                                    <t t-esc="total[account]['currency_id']"/>
                                                    <t t-esc="total[account]['balance']"/>
                                                </span>
                                            </strong>
                                        </th>
                                    </tr>
                                    <t t-if="total[account]['initial_balance']">
                                        <tr class="border-bottom" style="background:#f9f9f9;">
                                            <th colspan="6" style="width:10%;font-style:italic;color:#888;">
                                                Solde initial
                                            </th>
                                            <th style="width:10%"/>
                                            <th style="width:10%"/>
                                            <th style="width:10%"/>
                                            <th style="width:10%">
                                                <span>
                                                    <t t-if="total[account]['initial_debit']"
                                                       t-esc="total[account]['currency_id']"/>
                                                    <t t-if="total[account]['initial_debit']"
                                                       t-esc="total[account]['initial_debit']"/>
                                                </span>
                                            </th>
                                            <th style="width:10%">
                                                <span>
                                                    <t t-if="total[account]['initial_credit']"
                                                       t-esc="total[account]['currency_id']"/>
                                                    <t t-if="total[account]['initial_credit']"
                                                       t-esc="total[account]['initial_credit']"/>
                                                </span>
                                            </th>
                                            <th style="width:10%">
                                                <span class="fw-bolder">
                                                    <t t-esc="total[account]['currency_id']"/>
                                                    <t t-esc="total[account]['initial_balance']"/>
                                                </span>
                                            </th>
                                        </tr>
                                    </t>
                                    <t t-set="account_id_val" t-value="total[account]['account_id']"/>
                                    <t t-if="account_data.get(account_id_val)">
                                        <t t-foreach="account_data[account_id_val]"
                                           t-as="valuelist"
                                           t-key="valuelist_index">
                                            <t t-set="move_data" t-value="valuelist[0] if isinstance(valuelist, list) else valuelist"/>
                                            <tr class="border-bottom">
                                                <th colspan="6" style="width:10%">
                                                    <span>
                                                        <t t-esc="move_data.get('move_name', '')"/>
                                                    </span>
                                                </th>
                                                <th style="width:10%">
                                                    <span>
                                                        <t t-esc="move_data.get('date', '')"/>
                                                    </span>
                                                </th>
                                                <th style="width:10%">
                                                    <span>
                                                        <t t-esc="move_data.get('name', '')"/>
                                                    </span>
                                                </th>
                                                <th style="width:10%">
                                                    <span>
                                                        <t t-if="move_data.get('partner_id')"
                                                           t-esc="move_data['partner_id'][1]"/>
                                                    </span>
                                                </th>
                                                <th style="width:10%">
                                                    <span>
                                                        <t t-if="move_data.get('debit')"
                                                           t-esc="move_data['debit']"/>
                                                    </span>
                                                </th>
                                                <th style="width:10%">
                                                    <span>
                                                        <t t-if="move_data.get('credit')"
                                                           t-esc="move_data['credit']"/>
                                                    </span>
                                                </th>
                                                <th style="width:10%">
                                                    <span class="fw-bolder">
                                                        <t t-esc="move_data.get('balance', 0)"/>
                                                    </span>
                                                </th>
                                            </tr>
                                        </t>
                                    </t>
                                    </t>
                                </tbody>
                            </table>
<!--                        </t>-->
                    </t>
                    <table class="table table-sm table-reports">
                        <tbody>
                            <tr>
                                <th style="width:45%;">Total</th>
                                <th style="width:10%">
                                    <t t-out="grand_total['currency']"/>
                                    <t t-if="grand_total['total_debit']">
                                    <t t-out="grand_total['total_debit_display']"/>
                                    </t>
                                </th>
                                <th style="width:10%">
                                    <t t-out="grand_total['currency']"/>
                                    <t t-out="grand_total['total_credit_display']"/>
                                </th>
                                <th style="width:10%">
                                    <t t-out="grand_total['currency']"/>
                                    <t t-if="grand_total['total_debit'] and grand_total['total_credit']">
                                    <t t-out="float(grand_total['total_debit']) - float(grand_total['total_credit'])"/>
                                    </t>
                                </th>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
