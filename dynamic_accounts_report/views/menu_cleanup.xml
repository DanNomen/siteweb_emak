<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Safely disable duplicate menus via Python -->
        <function model="account.general.ledger" name="disable_duplicate_menus"/>
    </data>

    <!-- ===== Repositionner Dynamic Financial Reports en 1ère position ===== -->
    <record id="dynamic_report_accounting" model="ir.ui.menu">
        <field name="sequence" eval="5"/>
    </record>

    <!-- Action Serveur pour nettoyer les doublons manuellement -->
    <record id="action_clean_duplicate_menus" model="ir.actions.server">
        <field name="name">Nettoyer les Menus Doublons</field>
        <field name="model_id" ref="dynamic_accounts_report.model_account_general_ledger"/>
        <field name="state">code</field>
        <field name="code">
            env['account.general.ledger'].disable_duplicate_menus()
        </field>
    </record>

    <menuitem id="menu_clean_duplicate_menus"
              name="Nettoyer les Doublons"
              action="action_clean_duplicate_menus"
              parent="dynamic_accounts_report.dynamic_report_accounting"
              sequence="100"/>
</odoo>
