<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="emakmed_cart_stock_alert"
              inherit_id="website_sale.cart"
              name="EmakMed - Alerte stock dans le panier"
              active="True">
        <xpath expr="//t[@t-call='website_sale.cart_lines']" position="before">
            <t t-set="is_emakmed"
               t-value="'emakmed' in (website.name or '').lower() or 'emakmed' in (website.domain or '').lower()"/>
            <t t-if="is_emakmed">
                <t t-set="emakmed_warning"
                   t-value="request.session.pop('emakmed_stock_warning', None)"/>
                <t t-if="emakmed_warning">
                    <div id="emakmed_stock_alert"
                         class="alert alert-warning alert-dismissible fade show emakmed-stock-alert mx-3 mt-3"
                         role="alert">
                        <div class="d-flex align-items-start gap-3">
                            <i class="fa fa-exclamation-triangle fa-2x text-warning mt-1 flex-shrink-0"/>
                            <div>
                                <strong class="d-block mb-1">Information sur la disponibilité</strong>
                                <span t-esc="emakmed_warning"/>
                            </div>
                        </div>
                        <button type="button" class="btn-close"
                                data-bs-dismiss="alert" aria-label="Fermer"/>
                    </div>
                </t>
            </t>
        </xpath>
    </template>

    <template id="emakmed_layout_hide_stock"
              inherit_id="website.layout"
              name="EmakMed - Meta tag et masquage stock global"
              active="True">
        <xpath expr="//head" position="inside">
            <t t-set="is_emakmed"
               t-value="'emakmed' in (website and website.name or '').lower() or 'emakmed' in (website and website.domain or '').lower()"/>
            <t t-if="is_emakmed">
                <meta name="emakmed-site" content="true"/>
                <style type="text/css">
                    #availability_status,
                    .oe_website_sale_stock_product_detail,
                    .availability_message_warning,
                    .o_website_sale_stock_product_detail,
                    .out_of_stock_message,
                    .css_quantity.js_check_product_quantity {
                        display: none !important;
                    }
                </style>
            </t>
        </xpath>
    </template>

</odoo>
