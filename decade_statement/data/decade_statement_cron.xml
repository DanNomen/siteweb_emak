<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_decade_statement" model="ir.cron">
        <field name="name">Génération automatique Relevés Décadaires</field>
        <field name="model_id" ref="decade_statement.model_decade_statement"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_decade_statement()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">10</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="priority">10</field>
    </record>

</odoo>
