<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dashboard_direction" model="ir.module.category">
        <field name="name">Tableau de Bord Direction</field>
        <field name="sequence">1</field>
    </record>

    <record id="group_dashboard_direction" model="res.groups">
        <field name="name">DG / PDG - Accès Tableau de Bord</field>
        <field name="category_id" ref="module_category_dashboard_direction"/>
        <field name="comment">Accès réservé à la direction générale : KPI financiers et stock consolidés.</field>
    </record>

    <!-- Cron : snapshot mensuel de la valeur du stock -->
    <record id="cron_stock_value_snapshot" model="ir.cron">
        <field name="name">Dashboard Direction: Snapshot valeur stock</field>
        <field name="model_id" ref="model_dashboard_stock_value_history"/>
        <field name="state">code</field>
        <field name="code">model._cron_snapshot_stock_value()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
